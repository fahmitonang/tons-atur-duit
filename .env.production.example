# Salin file ini ke .env.production dan isi dengan nilai yang sesuai
# JANGAN commit file .env.production ke repositori!

# Database
DATABASE_URL=mysql://finance_user:GANTI_PASSWORD_DB@db:3306/finance_tracker
MARIADB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD
MARIADB_DATABASE=finance_tracker
MARIADB_USER=finance_user
MARIADB_PASSWORD=GANTI_PASSWORD_DB

# NextAuth
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=GANTI_DENGAN_SECRET_YANG_AMAN
NEXTAUTH_URL=http://localhost:3000

